
INSTALL_PLUGINS_DIR	=	/usr/lib64/ladspa/

CC	= gcc
CFLAGS	= -I. -O3 -Wall -fomit-frame-pointer -fstrength-reduce -funroll-loops -ffast-math -c -fPIC -DPIC
LDFLAGS	= -nostartfiles -shared -Wl,-Bsymbolic -lm
MODULES = $(wildcard *.c)

all: $(MODULES:%.c=%.dll)

przem-low-shelf.o: przem-low-shelf.h

%.o: %.c ladspa.h
	$(CC) $(CFLAGS) $< -o $@

%.dll: %.o
	$(CC) -o $@ $< $(LDFLAGS)

clean:
	-rm -f *.dll *.o *~

.PHONY: all install clean
